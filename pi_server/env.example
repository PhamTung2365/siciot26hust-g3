# Copy to .env, replace every placeholder, and keep the file private.
FLASK_SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# One-door MQTT MVP. Keep these passwords different.
MQTT_ENABLED=true
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_DOOR_ID=front-door
MQTT_WEB_PASSWORD=replace-with-a-strong-web-mqtt-password
MQTT_DEVICE_PASSWORD=replace-with-a-different-device-password
DOOR_OPEN_SECONDS=5
DOOR_COMMAND_COOLDOWN=10
